# Chép thành .env (KHÔNG đưa .env lên git) rồi điền giá trị thật.
POSTGRES_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(48))"
BETTER_AUTH_SECRET=
# Địa chỉ người dùng mở web (đổi khi đưa lên tên miền thật, ví dụ https://nhaphuhoa.example.vn)
PUBLIC_URL=http://localhost:3000
# Tài khoản quản trị được tạo ở lần chạy đầu (mật khẩu >= 8 ký tự)
ADMIN_EMAIL=admin@phuhoa.local
ADMIN_PASSWORD=
# Tùy chọn: khóa Groq (miễn phí, console.groq.com/keys) để bật trợ lý AI; để trống thì trợ lý dùng mô hình ý định ngoại tuyến
GROQ_API_KEY=
